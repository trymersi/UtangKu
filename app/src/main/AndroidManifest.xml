<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminder & Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- TIDAK ADA INTERNET — privacy by design -->

    <application
        android:name=".HutangPiutangApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UtangKu"
        tools:targetApi="35">

        <!-- Dashboard (launcher) -->
        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tambah / Edit Catatan -->
        <activity
            android:name=".ui.adddebt.AddEditDebtActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detail Catatan -->
        <activity
            android:name=".ui.detail.DebtDetailActivity"
            android:exported="false" />

        <!-- Daftar Kontak -->
        <activity
            android:name=".ui.contact.ContactListActivity"
            android:exported="false" />

        <!-- Detail Kontak -->
        <activity
            android:name=".ui.contact.ContactDetailActivity"
            android:exported="false" />

        <!-- Pengaturan -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- Tentang -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />

        <!-- Reminder BroadcastReceiver -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Mark Paid dari notification action -->
        <receiver
            android:name=".reminder.MarkPaidReceiver"
            android:exported="false" />

        <!-- Re-schedule reminders after device reboot -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
