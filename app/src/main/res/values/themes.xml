<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: Material Components DayNight -->
    <style name="Theme.UtangKu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Surface & background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Default widget styles -->
        <item name="materialCardViewStyle">@style/Widget.UtangKu.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.UtangKu.FAB</item>
        <item name="chipStyle">@style/Widget.UtangKu.Chip</item>
        <item name="textInputStyle">@style/Widget.UtangKu.TextInputLayout</item>
    </style>

    <!-- MaterialCardView default -->
    <style name="Widget.UtangKu.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- FAB -->
    <style name="Widget.UtangKu.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
    </style>

    <!-- Chip (filter) -->
    <style name="Widget.UtangKu.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_unselected</item>
        <item name="android:textColor">@color/chip_text_unselected</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- TextInputLayout -->
    <style name="Widget.UtangKu.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.UtangKu.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/on_primary</item>
    </style>

    <!-- Bottom Sheet -->
    <style name="Theme.UtangKu.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.UtangKu.BottomSheet</item>
    </style>

    <style name="Widget.UtangKu.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.UtangKu.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.UtangKu.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.UtangKu.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.UtangKu.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.UtangKu.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/on_surface_secondary</item>
    </style>

    <!-- Button -->
    <style name="Widget.UtangKu.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.UtangKu.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.UtangKu.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Danger button for destructive actions -->
    <style name="Widget.UtangKu.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/hutang_red</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
